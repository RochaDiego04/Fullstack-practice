# Copy this file to .env.test.
# Loaded automatically when NODE_ENV=test (see src/config/db.ts / nodemailer.ts).
# Matches the credentials baked into docker-compose.test.yml — run
# `npm run test:db:up` to start that container before running tests.

DATABASE_URL=postgresql://cashtrackr:cashtrackr@localhost:5433/cashtrackr_test

EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_password

JWT_SECRET=change_this_secret

FRONTEND_URL=http://localhost:3000
