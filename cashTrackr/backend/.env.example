# Copy this file to .env and fill in real values.
# Used whenever NODE_ENV !== "test" (dev, build, start).
# For running tests, see .env.test.example instead.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/database

# SMTP credentials (e.g. a Mailtrap sandbox inbox for local dev)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_password

# Secret used to sign JWTs — use a long random string
JWT_SECRET=change_this_secret

FRONTEND_URL=http://localhost:3000 # replace this with deployment frontend url
