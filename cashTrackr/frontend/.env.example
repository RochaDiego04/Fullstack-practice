# Copy this file to .env (or .env.local to override it — Next.js prefers
# .env.local, and that's what's actually used for local dev right now).

# Base URL of the backend API, including its version prefix.
API_URL=http://localhost:4000/api/v1 # replace this with deployment url
NEXT_PUBLIC_URL=http://localhost:3000 # replace this with deployment url too